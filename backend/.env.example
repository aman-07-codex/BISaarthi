# =================================================================
# BISaarthi Backend Environment Variables Reference (.env.example)
# =================================================================
# NOTE: DO NOT commit actual secrets to version control.
# Set appropriate values in your local .env or deployment environments.

# 1. Application Settings
APP_NAME=BISaarthi
APP_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:3000

# 2. Database Configuration (Supabase PostgreSQL / Async SQLAlchemy)
# For Supabase PostgreSQL (Production / Staging):
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bisaarthi

# 3. Authentication & Security
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 4. CORS Origins (Optional comma-separated list of additional allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:3000,https://bisaarthi-sigma.vercel.app

# 5. Google Gemini LLM Provider Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=30.0
GEMINI_MAX_OUTPUT_TOKENS=2048
LLM_PROVIDER=gemini
